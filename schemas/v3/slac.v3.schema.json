{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/veg/hyphy-3/main/schemas/v3/slac.v3.schema.json",
  "title": "HyPhy 3 Single-Likelihood Ancestor Counting (SLAC) Analysis Schema v3.0",
  "description": "Standardized output schema for HyPhy 3 SLAC site-level selection analyses.",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "analysis",
    "software",
    "provenance",
    "dataset",
    "phylogeny",
    "model_fits",
    "statistical_tests",
    "site_results"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^3\\.[0-9]+\\.[0-9]+$"
    },
    "analysis": {
      "type": "object",
      "required": ["id", "name", "version", "category", "description"],
      "properties": {
        "id": { "type": "string", "enum": ["slac"] },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["citation"],
            "properties": {
              "citation": { "type": "string" },
              "doi": { "type": "string" },
              "pmid": { "type": "string" }
            }
          }
        },
        "settings": {
          "type": "object"
        }
      }
    },
    "software": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "git_commit": { "type": "string" },
        "build_type": { "type": "string" },
        "compiler": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["invocation", "inputs", "execution"],
      "properties": {
        "invocation": {
          "type": "object",
          "required": ["cli_command"],
          "properties": {
            "cli_command": { "type": "string" },
            "working_directory": { "type": "string" },
            "arguments": { "type": "object" }
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string" },
              "format": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "size_bytes": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "execution": {
          "type": "object",
          "required": ["start_time", "end_time", "wall_time_seconds", "cpu_threads"],
          "properties": {
            "start_time": { "type": "string" },
            "end_time": { "type": "string" },
            "wall_time_seconds": { "type": "number", "minimum": 0 },
            "cpu_threads": { "type": "integer", "minimum": 1 },
            "hostname": { "type": "string" },
            "os": { "type": "string" },
            "compiler": { "type": "string" }
          }
        }
      }
    },
    "dataset": {
      "type": "object",
      "required": ["taxa_count", "codon_sites", "nucleotide_sites", "unique_patterns", "taxa"],
      "properties": {
        "taxa_count": { "type": "integer", "minimum": 1 },
        "codon_sites": { "type": "integer", "minimum": 1 },
        "nucleotide_sites": { "type": "integer", "minimum": 3 },
        "unique_patterns": { "type": "integer", "minimum": 1 },
        "taxa": { "type": "array", "items": { "type": "string" } },
        "genetic_code": { "type": "object" },
        "partitions": { "type": "array" },
        "sequences": { "type": "object" }
      }
    },
    "phylogeny": {
      "type": "object",
      "required": ["newick"],
      "properties": {
        "newick": { "type": "string" },
        "nodes": { "type": "object" },
        "tree_length": { "type": "number" }
      }
    },
    "model_fits": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["log_likelihood", "aicc", "parameters_count"],
        "properties": {
          "description": { "type": "string" },
          "log_likelihood": { "type": "number" },
          "aicc": { "type": "number" },
          "parameters_count": { "type": "integer", "minimum": 0 },
          "equilibrium_frequencies": { "type": "object" },
          "substitution_rates": { "type": "object" },
          "global_parameters": { "type": "object" }
        }
      }
    },
    "statistical_tests": {
      "type": "object",
      "required": ["site_level_summary"],
      "properties": {
        "site_level_summary": {
          "type": "object",
          "required": [
            "method",
            "test_statistic",
            "threshold",
            "total_sites",
            "diversifying_count",
            "purifying_count",
            "neutral_count"
          ],
          "properties": {
            "method": { "type": "string" },
            "test_statistic": { "type": "string" },
            "threshold": { "type": "number" },
            "total_sites": { "type": "integer" },
            "diversifying_count": { "type": "integer" },
            "purifying_count": { "type": "integer" },
            "neutral_count": { "type": "integer" },
            "tested_branches_count": { "type": "integer" },
            "background_branches_count": { "type": "integer" },
            "total_tested_tree_length": { "type": "number" }
          }
        }
      }
    },
    "site_results": {
      "type": "object",
      "required": ["columns", "data"],
      "properties": {
        "columns": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["type", "description"],
            "properties": {
              "type": { "type": "string" },
              "unit": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "data": {
          "type": "object",
          "required": [
            "site",
            "ES",
            "EN",
            "S",
            "N",
            "P_S",
            "dS",
            "dN",
            "dN_minus_dS",
            "p_positive",
            "p_negative",
            "classification"
          ],
          "properties": {
            "site": { "type": "array", "items": { "type": "integer" } },
            "ES": { "type": "array", "items": { "type": "number" } },
            "EN": { "type": "array", "items": { "type": "number" } },
            "S": { "type": "array", "items": { "type": "number" } },
            "N": { "type": "array", "items": { "type": "number" } },
            "P_S": { "type": "array", "items": { "type": "number" } },
            "dS": { "type": "array", "items": { "type": ["number", "null"] } },
            "dN": { "type": "array", "items": { "type": ["number", "null"] } },
            "dN_minus_dS": { "type": "array", "items": { "type": ["number", "null"] } },
            "p_positive": { "type": "array", "items": { "type": "number" } },
            "p_negative": { "type": "array", "items": { "type": "number" } },
            "total_branch_length": { "type": "array", "items": { "type": "number" } },
            "classification": { "type": "array", "items": { "type": "string" } },
            "S_median": { "type": "array", "items": { "type": "number" } },
            "S_ci_lower": { "type": "array", "items": { "type": "number" } },
            "S_ci_upper": { "type": "array", "items": { "type": "number" } },
            "N_median": { "type": "array", "items": { "type": "number" } },
            "N_ci_lower": { "type": "array", "items": { "type": "number" } },
            "N_ci_upper": { "type": "array", "items": { "type": "number" } },
            "dS_median": { "type": "array", "items": { "type": ["number", "null"] } },
            "dS_ci_lower": { "type": "array", "items": { "type": ["number", "null"] } },
            "dS_ci_upper": { "type": "array", "items": { "type": ["number", "null"] } },
            "dN_median": { "type": "array", "items": { "type": ["number", "null"] } },
            "dN_ci_lower": { "type": "array", "items": { "type": ["number", "null"] } },
            "dN_ci_upper": { "type": "array", "items": { "type": ["number", "null"] } }
          }
        }
      }
    }
  }
}
